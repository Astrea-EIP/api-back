<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>proto_back</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);engine/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AstreaEngine">
      <HintPath>lib/AstreaEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="engine/**/*.cs" />
    <None Remove="engine/**" />
    <Content Remove="engine/**" />
    <EmbeddedResource Remove="engine/**" />
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="api-back.Tests" />
  </ItemGroup>

</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org"
  },
  "Jwt": {
    "Issuer": "astrea-api",
    "Audience": "astrea-apps",
    "AnonymousTokenLifetimeMinutes": 1440,
    "UserTokenLifetimeMinutes": 10080
  },
  "AuthRateLimit": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "RegisterPermitLimit": 10,
    "RegisterWindowSeconds": 3600,
    "FailedLoginsPerEmail": 10,
    "FailedLoginWindowSeconds": 900,
    "TrustedProxies": []
  },
  "MongoDb": {
    "ConnectionString": "<Insert-Your-MongoDB-Connection-String-Here>",
    "DatabaseName": "astrea_proto"
  }
}